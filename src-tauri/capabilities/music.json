{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "music",
  "description": "Local Aura Music may use native music and media commands and read theme preferences. It cannot update settings or execute arbitrary programs.",
  "windows": ["music"],
  "permissions": [
    "allow-open-music",
    "allow-music-account-status",
    "allow-music-connect",
    "allow-music-disconnect",
    "allow-music-browse",
    "allow-music-change",
    "allow-music-open-player",
    "allow-music-artwork",
    "allow-music-playback-status",
    "allow-music-select-session",
    "allow-music-media-control",
    "allow-get-preferences",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-close"
  ]
}
