{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "widget-host",
  "description": "Only the host may query foundation metadata, open settings, and issue topmost window commands.",
  "windows": ["widget-host"],
  "permissions": [
    "allow-github-status",
    "allow-github-start-authorization",
    "allow-github-cancel-authorization",
    "allow-github-refresh",
    "allow-github-disconnect",
    "allow-github-open-destination",
    "allow-open-music",
    "allow-music-account-status",
    "allow-music-connect",
    "allow-music-disconnect",
    "allow-music-browse",
    "allow-music-change",
    "allow-music-open-player",
    "allow-music-artwork",
    "allow-music-playback-status",
    "allow-music-select-session",
    "allow-music-media-control",
    "allow-music-media-seek",
    "allow-music-media-volume",
    "allow-get-foundation-info",
    "allow-open-settings",
    "allow-get-system-snapshot",
    "allow-get-preferences",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "core:window:allow-set-always-on-top"
  ]
}
