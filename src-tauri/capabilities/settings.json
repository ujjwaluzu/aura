{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "Settings can read and update validated preferences and use the music account and media session controls. It cannot read system usage.",
  "windows": ["settings"],
  "permissions": [
    "allow-get-preferences",
    "allow-set-preferences",
    "allow-open-music",
    "allow-music-account-status",
    "allow-music-connect",
    "allow-music-disconnect",
    "allow-music-playback-status",
    "allow-music-select-session",
    "allow-music-media-control",
    "allow-music-media-seek",
    "allow-music-media-volume",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-close"
  ]
}
