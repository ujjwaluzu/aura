{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aura",
  "version": "0.1.3-beta.1",
  "identifier": "com.projectaura.desktop",
  "build": {
    "beforeDevCommand": "pnpm.cmd dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm.cmd licenses:generate && pnpm.cmd build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "widget-host",
        "title": "Aura",
        "url": "index.html",
        "width": 760,
        "height": 264,
        "center": true,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "shadow": false,
        "noRedirectionBitmap": true,
        "alwaysOnTop": false,
        "skipTaskbar": false
      },
      {
        "label": "settings",
        "title": "Aura Settings",
        "url": "index.html?window=settings",
        "create": false,
        "width": 960,
        "height": 720,
        "center": true,
        "resizable": true,
        "maximizable": true,
        "decorations": true,
        "transparent": false,
        "backgroundColor": "#111318",
        "theme": "Dark",
        "shadow": true,
        "minWidth": 720,
        "minHeight": 560
      }
    ],
    "security": {
      "capabilities": ["widget-host", "settings"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'; form-action 'none'",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; object-src 'none'; base-uri 'self'; frame-src 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Utility",
    "shortDescription": "A considered space for your desktop widgets",
    "longDescription": "Aura is a Windows desktop personalisation application. This foundation release establishes a transparent widget host and a separate settings window.",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "icons/icon.ico": "Aura.ico",
      "../LICENSE": "LICENSE.txt"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh",
        "displayLanguageSelector": false
      }
    }
  }
}
